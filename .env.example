# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Python ────────────────────────────────────────────────────────────────────
PYTHON_PATH=python3

# ─── Paths (auto-detectados se omitidos) ───────────────────────────────────────
# MODELS_DIR=/app/models
# CACHE_DIR=/app/cache
# LOGS_DIR=/app/logs
# TEMP_DIR=/app/temp

# ─── Piper TTS ─────────────────────────────────────────────────────────────────
# Vozes a carregar (comma-separated, devem existir em $MODELS_DIR/piper/)
# pt_BR-edresson-low  (~28 MB) — leve, padrão para MVP
# pt_BR-faber-medium  (~60 MB) — melhor qualidade
# pt_BR-coqui-medium  (~60 MB) — voz feminina
PIPER_VOICES=pt_BR-edresson-low

# ─── TTS Defaults ──────────────────────────────────────────────────────────────
DEFAULT_VOICE=pt_BR-edresson-low
DEFAULT_SPEED=1.0
MAX_TEXT_LENGTH=2000
PYTHON_WORKER_TIMEOUT_MS=60000

# ─── Cache ─────────────────────────────────────────────────────────────────────
CACHE_MAX_AGE_HOURS=12
MAX_CACHE_SIZE_MB=300
CLEANUP_INTERVAL_MS=3600000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
